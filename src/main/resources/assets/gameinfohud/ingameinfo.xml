        <line>
            <var>biomelabel</var>
            <str>$3</str>
            <var>biome</var>
            <str>$f</str>
            <if>
                <var>slimes</var>
                <str> ($aSlime$f)</str>
            </if>
            <str>&#160;</str>
            <var>temphumidity</var>
        </line>
