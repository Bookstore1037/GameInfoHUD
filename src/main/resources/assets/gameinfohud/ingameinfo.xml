            <var>offsetlabel</var>
            <str>$6</str>
            <var>chunkoffsetx</var>
            <str>$f</str>
            <str>:</str>
            <str>$6</str>
            <var>chunkoffsetz</var>
            <str>$f</str>
            <str> Y=</str>
            <str>$6</str>
            <var>yi</var>
            <str>$f</str>
            <str>&#160;</str>
            <var>facinglabel</var>
            <str>$6</str>
            <var>roughdirection</var>
            <str>$f</str>
            <str> (</str>
            <var>direction</var>
            <str>°) </str>
        </line>
        <!-- 光照 -->
        <line>
            <var>lightlabel</var>
            <str>$e</str>
            <var>light</var>
            <str>$f</str>
            <str> (</str>
            <var>skylabel</var>
            <str>$e</str>
            <var>lightsun</var>
            <str>$f</str>
            <str>&#160;</str>
            <var>blocklabel</var>
            <str>$e</str>
            <var>lightnosun</var>
            <str>$f</str>
            <str>) </str>
            <var>feetlabel</var>
            <str>$e</str>
            <var>lightfeet</var>
            <str>$f</str>
            <str> (</str>
            <var>lightsunfeet</var>
            <str>:</str>
            <var>lightnosunfeet</var>
            <str>) </str>
        </line>
        <!-- Seed -->
        <line>
            <str>Seed: </str>
            <var>seed</var>
        </line>
        <!-- EXP -->
        <line>
            <str>$fEXP: $e{xpthislevel}$f / $e{xpcap}$f ($e</str>
            <round>
                <pct>
                    <var>xpthislevel</var>
                    <var>xpcap</var>
                </pct>
                <num>0</num>
            </round>
            <str>%$f)</str>
        </line>
        <!-- 天气 -->
        <line>
            <var>weatherlabel</var>
            <str>&#160;</str>
            <var>weather</var>
        </line>
