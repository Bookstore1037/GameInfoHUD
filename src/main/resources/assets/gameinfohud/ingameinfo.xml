<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<config>
    <lines at="topleft">
        <!-- 玩家名 FPS Ping 现实时间 -->
        <line>
            <str>$6</str>
            <var>username</var>
            <str>$f</str>
            <str> FPS: </str>
            <operation>
                <str>ge</str>
                <var>fps</var>
                <num>60</num>
                <num>45</num>
                <num>30</num>
                <num>15</num>
                <num>0</num>
                <str>$a</str>
                <str>$e</str>
                <str>$6</str>
                <str>$c</str>
                <str>$4</str>
                <str/>
            </operation>
            <var>fps</var>
            <str>$f&#160;Ping: </str>
            <str>$a</str>
            <var>ping</var>
            <str>$f</str>
            <str>&#160;</str>
            <var>rltime24</var>
        </line>
