        <line>
            <var>worldlabel</var>
            <str>$6</str>
            <var>dimension</var>
            <str>$f</str>
            <str>&#160;</str>
            <var>chunkslabel</var>
            <str>$6</str>
            <var>loadedchunks</var>
            <str>$f</str>
            <str>&#160;</str>
            <var>moonphaselabel</var>
            <str>: </str>
            <str>$e</str>
            <var>moonphase</var>
            <str>$f</str>
        </line>
        <!-- 实体 -->
        <line>
            <var>entitiesline</var>
        </line>
